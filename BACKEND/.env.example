# ==============================================================================
# CarePulse HMS — Backend Environment Variables Template
# ==============================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/carepulse_hms

# JWT Authentication Secret & Expiration
JWT_SECRET=carepulse_jwt_secret_key_change_in_production
JWT_EXPIRE=30d

# Cloudinary Storage Configuration (Optional: fallback to data URI buffer if empty)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
