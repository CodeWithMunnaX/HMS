# ==============================================================================
# CarePulse HMS — Root .gitignore
# ==============================================================================

# Dependencies
**/node_modules/
node_modules/

# Production Build Outputs
**/dist/
dist/
**/dist-ssr/
dist-ssr/
**/build/
build/

# Environment Variables & Secrets
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
!.env.example

# Debug & Runtime Logs
**/logs/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# System & Editor Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.orig

# Local Temp & Artifacts
.tmp/
temp/
coverage/
.nyc_output/

branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
